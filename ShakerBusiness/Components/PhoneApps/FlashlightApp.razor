<div class="flex h-full w-full cursor-pointer flex-col items-center justify-center gap-4 @(_on ? "bg-white" : "bg-cartel-ink")" @onclick="Toggle">
    <div class="flex h-24 w-24 items-center justify-center rounded-full transition-transform active:scale-95 @(_on ? "bg-cartel-ink/10" : "bg-cartel-cream/10")">
        <svg viewBox="0 0 24 24" class="h-12 w-12 @(_on ? "text-cartel-ink" : "text-cartel-cream")" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
    </div>
    @if (!_on)
    {
        <span class="text-sm text-cartel-cream/50">Antippen zum Einschalten</span>
    }
    else
    {
        <span class="text-sm text-cartel-ink/50">Antippen zum Ausschalten</span>
    }
</div>

@code {
    [Parameter]
    public EventCallback<bool> OnActiveChanged { get; set; }

    private bool _on;

    private async Task Toggle()
    {
        _on = !_on;
        await OnActiveChanged.InvokeAsync(_on);
    }
}
