@using ShakerBusiness.Models
@using ShakerBusiness.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject GameEngineService Engine

<div class="flex h-full flex-col overflow-hidden bg-cartel-cream">
    <canvas id="shaker-snake-canvas" class="aspect-square w-full flex-shrink-0 cursor-pointer"></canvas>

    <div class="flex flex-shrink-0 flex-col items-center gap-0.5 px-4 py-2">
        <div class="flex w-full items-center justify-between text-xs font-semibold text-cartel-ink/70">
            <span id="shaker-snake-score">Score: 0</span>
            <span id="shaker-snake-best">Best: 0</span>
        </div>
        <span class="text-[1rem] text-cartel-ink/50">Steuerung: Pfeiltasten oder WASD</span>
    </div>
</div>

@code {
    private DotNetObjectReference<ShakerSnakeApp>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var businessImages = GameData.Businesses.Select(b => b.ImagePath).ToArray();
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("shakerSnake.init", "shaker-snake-canvas", "images/businesses/Oli.png", businessImages, Engine.SnakeHighScore, _dotNetRef);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    [JSInvokable]
    public void OnSnakeRunStarted() => Engine.OnSnakeRunStarted();

    [JSInvokable]
    public void OnSnakeFoodEaten() => Engine.OnSnakeFoodEaten();

    [JSInvokable]
    public async Task OnSnakeGameOver()
    {
        await Engine.OnSnakeGameOverAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("shakerSnake.destroy");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        _dotNetRef?.Dispose();
    }
}
