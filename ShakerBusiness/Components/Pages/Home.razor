        StartGameLoopIfAuthenticated();
        StateHasChanged();
    }

    private bool _volumeSynced;
    private bool _guestResumeChecked;
    private bool _sidebarHeightSynced;
    private DotNetObjectReference<Home>? _flushOnHideRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_sidebarHeightSynced && _initialized && Engine.IsAuthenticated)
        {
            _sidebarHeightSynced = true;
            try
            {
                await JS.InvokeVoidAsync("shakerEffects.syncSidebarHeight", "business-grid", "leaderboard-aside");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (!_guestResumeChecked && !Engine.IsAuthenticated)
        {
            _guestResumeChecked = true;
            string? existingGuestState = null;
            try
            {
                existingGuestState = await JS.InvokeAsync<string?>("shakerEffects.readGuestState");
            }
            catch (JSDisconnectedException)
            {
            }

            if (!string.IsNullOrEmpty(existingGuestState))
            {
                await Engine.InitializeGuestAsync(existingGuestState);
                StartGameLoopIfAuthenticated();
                StateHasChanged();
            }
        }

        if (!_volumeSynced && Engine.IsAuthenticated)
        {
            _volumeSynced = true;

            if (!Engine.IsGuest)
            {
                await JS.InvokeVoidAsync("shakerEffects.clearGuestState");
            }

            await JS.InvokeVoidAsync("shakerAudio.applyStoredVolume", "volume-slider");
            await JS.InvokeVoidAsync("shakerAudio.armAutoplayOnFirstClick");
            await RestoreManualClickTokensAsync();

            var storedBuyMode = await JS.InvokeAsync<string?>("shakerEffects.readBuyMode");
            if (!string.IsNullOrEmpty(storedBuyMode) && Enum.TryParse<BuyMultiplier>(storedBuyMode, out var buyMode))
            {
                Engine.SetBuyMode(buyMode);
            }

            _flushOnHideRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("shakerEffects.registerFlushOnHide", _flushOnHideRef);
                await JS.InvokeVoidAsync("shakerEffects.registerActivityTracking", _flushOnHideRef, 20000);
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }

            StateHasChanged();
        }
    }

