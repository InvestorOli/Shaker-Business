    private static bool IsCurrentlyEarning(BusinessSnapshot snapshot) =>
        snapshot.Owned > 0 && (snapshot.HasManager || snapshot.CycleAnchorUtc is not null);

    private static BigValue PerSecondRevenue(BusinessSnapshot snapshot)
    {
        if (!IsCurrentlyEarning(snapshot))
        {
            return BigValue.Zero;
        }

        return snapshot.EffectiveCycleSeconds <= 0
            ? snapshot.EffectiveRevenue.Multiply(10)
            : snapshot.EffectiveRevenue.DivideBy(snapshot.EffectiveCycleSeconds);
    }

