    private async Task OnIconClick(BusinessSnapshot snapshot)
    {
        var isClickable = snapshot.Unlocked && snapshot.Owned > 0 && !snapshot.HasManager;
        if (!isClickable)
        {
            return;
        }

        var wasEligible = snapshot.ProgressFraction <= 0 || snapshot.ProgressFraction >= 1;
        var gain = Engine.ManualClick(snapshot.Definition.Id);

        if (wasEligible)
        {
            _lastClickGain[snapshot.Definition.Id] = (gain ?? snapshot.EffectiveRevenue.ToBigInteger(), DateTime.UtcNow);
        }

        if (Engine.LastManualClickToken is { } issued)
        {
            await JS.InvokeVoidAsync("shakerEffects.storeManualClickToken", issued.BusinessId, issued.Token);
        }
    }

    private async Task RestoreManualClickTokensAsync()
    {
        var json = await JS.InvokeAsync<string>("shakerEffects.readAndClearManualClickTokens");
        Dictionary<string, string>? tokens;
        try
        {
            tokens = JsonSerializer.Deserialize<Dictionary<string, string>>(json);
        }
        catch (JsonException)
        {
            return;
        }

        if (tokens is null)
        {
            return;
        }

        foreach (var (businessId, token) in tokens)
        {
            Engine.RestoreManualChargeFromToken(businessId, token);
        }
    }

