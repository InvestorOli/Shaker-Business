    public async ValueTask DisposeAsync()
    {
        Engine.SessionSuperseded -= HandleSessionSuperseded;
        MaintenanceMode.OnChanged -= HandleMaintenanceModeChanged;
        GameEnd.Ended -= HandleGameEnded;
        GameEnd.Changed -= HandleGameEndChanged;

        _timer?.Dispose();
        _timer = null;

        if (_tickLoop is not null)
        {
            try
            {
                await _tickLoop;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Tick loop ended with an error");
            }
        }

        if (Engine.IsAuthenticated)
        {
            try
            {
                await Engine.FlushAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Final flush on dispose failed");
            }
        }

        _flushOnHideRef?.Dispose();
    }
