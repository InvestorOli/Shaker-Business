    private static string FormatCountdown(double remainingSeconds)
    {
        var span = TimeSpan.FromSeconds(Math.Max(0, remainingSeconds));
        if (span.TotalDays >= 1)
        {
            return $"{(int)span.TotalDays}T {span:hh\\:mm\\:ss}";
        }

        return span.TotalHours >= 1
            ? span.ToString(@"hh\:mm\:ss")
            : span.ToString(@"mm\:ss");
    }

    private static string FormatOfflineDuration(TimeSpan span)
    {
        var days = span.Days;
        var hours = span.Hours;
        var minutes = span.Minutes;

        if (days > 0)
        {
            var dayPart = $"{days} {(days == 1 ? "Tag" : "Tage")}";
            return hours > 0 ? $"{dayPart} {hours} {(hours == 1 ? "Stunde" : "Stunden")}" : dayPart;
        }

        if (hours > 0)
        {
            var hourPart = $"{hours} {(hours == 1 ? "Stunde" : "Stunden")}";
            return minutes > 0 ? $"{hourPart} {minutes} {(minutes == 1 ? "Minute" : "Minuten")}" : hourPart;
        }

        var totalMinutes = Math.Max(1, minutes);
        return $"{totalMinutes} {(totalMinutes == 1 ? "Minute" : "Minuten")}";
    }

    private async Task RunTickLoopAsync()
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync())
            {
                try
                {
                    await Engine.TickAsync();
                    CheckMilestones();
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex) when (ex is not ObjectDisposedException)
                {
                    Logger.LogWarning(ex, "Tick loop iteration failed - will retry next tick");
                }
            }
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void CheckMilestones()
    {
        foreach (var definition in GameData.Businesses)
        {
            var id = definition.Id;
            var owned = Engine.GetOwned(id);
            var previous = _lastOwned.GetValueOrDefault(id);
            if (owned > previous)
            {
                var crossed = GameData.AllUnlockThresholds(id).Where(t => previous < t && t <= owned).DefaultIfEmpty(0).Max();
                if (crossed > 0)
                {
                    _milestoneToast = (definition.Name, crossed, DateTime.UtcNow);
                }
            }

            _lastOwned[id] = owned;
        }
    }

